<script>
function slovaAutocomplete(config) {
    return {
        minChars:   config.minChars   || 3,
        suggestUrl: config.suggestUrl || '',
        open:       false,
        data:       { categories: [], publishers: [], products: [] },
        _query:     '',

        init() {
            // Bail out if this instance lives in a CSS-hidden container.
            // Both #carusel-search-desktop and #carusel-search-mobile are always
            // in the DOM; the media query in header.phtml sets display:none on
            // whichever container doesn't match the current breakpoint.
            // getComputedStyle reads the actual computed value including media queries,
            // so this guard is always in sync with what the user actually sees.
            const container = this.$el.closest('#carusel-search-desktop, #carusel-search-mobile');
            if (!container || getComputedStyle(container).display === 'none') {
                container && container.setAttribute('aria-hidden', 'true');
                return;
            }
            container.removeAttribute('aria-hidden');

            // Create overlay as a direct <body> child — outside any stacking context.
            // Exactly one instance passes the guard per viewport, so one overlay total.
            this._overlay = document.createElement('div');
            Object.assign(this._overlay.style, {
                position: 'fixed', inset: '0',
                background: 'rgba(0,0,0,0.5)', zIndex: '25', display: 'none'
            });
            this._overlay.addEventListener('click', () => this.close());
            document.body.appendChild(this._overlay);

            this.$watch('open', value => {
                document.body.style.overflow = value ? 'hidden' : '';
                this._overlay.style.display  = value ? 'block' : 'none';
            });

            // If the search input is rendered outside this component (theme-level),
            // attach the listener to it directly.
            const externalInput = document.getElementById(config.inputId || 'search');
            if (externalInput && !this.$el.contains(externalInput)) {
                let timer;
                externalInput.addEventListener('input', (e) => {
                    clearTimeout(timer);
                    timer = setTimeout(() => this.onInput(e.target.value), 300);
                });
                externalInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') this.close();
                });
            }
        },

        async onInput(value) {
            const query = value.trim();
            if (query.length < this.minChars) {
                this.close();
                return;
            }
            this._query = query;
            try {
                const res = await fetch(
                    this.suggestUrl + '?q=' + encodeURIComponent(query),
                    { headers: { 'X-Requested-With': 'XMLHttpRequest' } }
                );
                if (!res.ok) throw new Error('network');
                const data = await res.json();
                if (query === this._query) {
                    this.data = data;
                    this.open = (this.data.categories?.length > 0) ||
                                (this.data.publishers?.length > 0) ||
                                (this.data.products?.length > 0);
                }
            } catch {
                this.close();
            }
        },

        close() {
            this.open = false;
            this.data = { categories: [], publishers: [], products: [] };
        }
    };
}
</script>
